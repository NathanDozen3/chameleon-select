{
  "name": "chameleon-select",
  "version": "1.0.5",
  "description": "A zero-config, style-sniffing custom select utility that adapts to your site's theme.",
  "main": "chameleon-select.min.js",
  "module": "chameleon-select.min.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/NathanDozen3/chameleon-select"
  },
  "bugs": {
    "url": "https://github.com/NathanDozen3/chameleon-select/issues"
  },
  "homepage": "https://github.com/NathanDozen3/chameleon-select#readme",
  "engines": {
    "node": ">=14"
  },
  "files": [
    "chameleon-select.js",
    "chameleon-select.min.js",
    "index.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./chameleon-select.js",
      "require": "./chameleon-select.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui"
  },
  "keywords": [
    "select",
    "custom-select",
    "ui",
    "accessibility",
    "ux",
    "form"
  ],
  "author": "Nathan Johnson",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "terser": "^5.20.1"
  }
}
